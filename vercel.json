{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/spa",
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api?__p=:path" },
    { "source": "/((?!api/|api$).*)", "destination": "/index.html" }
  ]
}
